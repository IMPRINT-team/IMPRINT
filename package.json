{
  "name": "imprint",
  "private": true,
  "workspaces": [
    "backend",
    "web-dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm install && node scripts/sync-backend-env.cjs && npm run db:init -w backend && concurrently \"npm run dev -w backend\" \"npm run dev -w web-dashboard\"",
    "verify": "node scripts/verify.js",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:verify": "node scripts/verify.js",
    "prisma:studio": "npm run prisma:studio -w backend"
  },
  "dependencies": {
    "@workos-inc/authkit-react": "^0.16.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "type": "module"
}
