{
  "name": "imprint",
  "private": true,
  "workspaces": [
    "backend",
    "web-dashboard"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w web-dashboard\"",
    "verify": "node scripts/verify.js",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:verify": "node scripts/verify.js",
    "prisma:studio": "npm run prisma:studio -w backend"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "type": "module"
}
