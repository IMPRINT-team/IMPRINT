{
  "name": "imprint",
  "private": true,
  "workspaces": ["backend", "web-dashboard", "packages/*"],
  "scripts": {
    "dev": "npm install && concurrently \"npm run dev -w backend\" \"npm run dev -w web-dashboard\"",
    "verify": "node scripts/verify.js",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:verify": "node scripts/verify.js",
    "prisma:studio": "npm run prisma:studio -w backend"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
