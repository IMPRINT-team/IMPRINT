generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Scanner {
  deviceId    String   @id @default(uuid()) @db.Uuid
  specificLocation  String   @unique
  location    String
  status      String   @default("ONLINE")
  createdAt   DateTime @default(now())    @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt
  authorization String @default("BASIC")

  events Event[]
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String   @db.Uuid
  uid         String
  eventType   String   @default("scan")
  occurredAt  DateTime @default(now())
  result      String   @default("ACCEPTED")

  scanner Scanner @relation(fields: [deviceId], references: [deviceId])

  @@index([occurredAt])
  @@index([uid])
}

model User {
  id           String    @id @default(uuid())
  rfidUid      String    @unique
  email        String?   @unique
  passwordHash String?
  accessLevel  String    @default("BASIC")
  createdAt    DateTime  @default(now())
  isRegistered Boolean   @default(false)
}