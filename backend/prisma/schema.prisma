generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Scanner {
  id          String   @id @default(uuid()) @db.Uuid
  deviceName  String   @unique
  location    String
  status      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  deviceName  String
  uid         String
  eventType   String   @default("scan")
  occurredAt  DateTime @default(now())

  scanner Scanner @relation(fields: [deviceName], references: [deviceName])

  @@index([occurredAt])
  @@index([deviceName])
  @@index([uid])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  rfidUid      String   @unique
  accessLevel  String
  isRegistered Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
