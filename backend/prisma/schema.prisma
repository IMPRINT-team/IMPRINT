generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Scanner {
  id          String   @id @default(uuid()) @db.Uuid
  deviceName  String   @unique
  location    String
  status      String   @default("ONLINE")
  createdAt   DateTime @default(now())    @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt
  authorization String @default("BASIC")

  events Event[]
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  deviceName  String
  uid         String
  eventType   String   @default("scan")
  occurredAt  DateTime @default(now())

  scanner Scanner @relation(fields: [deviceName], references: [deviceName])

  @@index([occurredAt])
  @@index([deviceName])
  @@index([uid])
}