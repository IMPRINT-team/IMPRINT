{
  "name": "imprint-backend",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "node index.js",
    "lint": "eslint .",
    "test": "node --test",
    "build": "npm install && node --check index.js",
    "db:init": "prisma migrate deploy && prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:verify": "node ../scripts/verify.js",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prisma": "^5.22.0"
  },
  "type": "module"
}
