{
  "name": "IMPRINT Dev Environment",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "app",
  "runServices": [
    "postgres",
    "backend"
  ],
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/workspace",

  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": {
      "label": "IMPRINT Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "IMPRINT Web Dashboard (Vite)",
      "onAutoForward": "openBrowserOnce"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postCreateCommand": "npm run dev"
}
